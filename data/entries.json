{
  "SPDX-FileCopyrightText": "2026 Gary Bissett <gary.bissett@gmail.com>",
  "SPDX-License-Identifier": "GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL",
  "version": 1,
  "entries": [
    {
      "id": "exe",
      "windows": ".exe file",
      "aliases": [
        "installer",
        "setup.exe",
        "msi",
        "install a program",
        "download software"
      ],
      "kde": "Software from Discover",
      "category": "System",
      "icon": "application-x-executable",
      "summary": "Windows programs do not run here directly, and you very rarely need one to. Software comes from Discover, already checked and updated with everything else. For a Windows program you cannot replace, Bottles or Wine will usually run it."
    },
    {
      "id": "pdf",
      "windows": "Adobe Reader",
      "aliases": [
        "acrobat",
        "open pdf",
        "pdf viewer"
      ],
      "kde": "Okular",
      "category": "Apps",
      "desktop": "org.kde.okular.desktop",
      "summary": "Reads PDFs, and also annotates, fills forms and signs them without asking you to buy anything."
    },
    {
      "id": "close-window",
      "windows": "Alt+F4",
      "aliases": [
        "close window",
        "quit application"
      ],
      "kde": "Close Window",
      "category": "Shortcuts",
      "icon": "window-close",
      "action": {
        "component": "kwin",
        "name": "Window Close"
      },
      "summary": "The same chord, and closing the last window of an application usually quits it here too."
    },
    {
      "id": "alt-tab",
      "windows": "Alt+Tab",
      "aliases": [
        "switch windows",
        "app switcher",
        "task switcher"
      ],
      "kde": "Walk Through Windows",
      "category": "Shortcuts",
      "action": {
        "component": "kwin",
        "name": "Walk Through Windows"
      },
      "summary": "Works exactly as you expect. The look of it, and whether it covers one desktop or all of them, is in System Settings under Window Management.",
      "icon": "preferences-system-windows"
    },
    {
      "id": "appdata",
      "windows": "AppData",
      "aliases": [
        "%appdata%",
        "roaming",
        "application settings",
        "config"
      ],
      "kde": "~/.config and ~/.local/share",
      "category": "Files",
      "icon": "folder",
      "summary": "Settings in ~/.config, data in ~/.local/share. Both are plain files in your home folder — copyable to a new machine, and safe to delete when an application misbehaves."
    },
    {
      "id": "bitlocker",
      "windows": "BitLocker",
      "aliases": [
        "encryption",
        "encrypt drive",
        "secure folder"
      ],
      "kde": "LUKS, and Plasma Vaults",
      "category": "System",
      "icon": "dialog-password",
      "summary": "Whole-disk encryption is chosen when the system is installed. For a folder rather than a disk, Plasma Vaults makes an encrypted one you unlock from the tray."
    },
    {
      "id": "bluetooth",
      "windows": "Bluetooth",
      "aliases": [
        "pair device",
        "headphones"
      ],
      "kde": "Bluetooth",
      "category": "Settings",
      "desktop": "kcm_bluetooth.desktop",
      "summary": "Pairing works the same way. Audio devices usually connect and pick the right profile on their own."
    },
    {
      "id": "c-drive",
      "windows": "C: drive",
      "aliases": [
        "drive letter",
        "D drive",
        "root",
        "my computer"
      ],
      "kde": "/ — the root of everything",
      "category": "Files",
      "icon": "drive-harddisk",
      "summary": "One tree rather than lettered drives. Other disks appear inside it, usually under /media, and Dolphin's Places is the friendly way in."
    },
    {
      "id": "calculator",
      "windows": "Calculator",
      "aliases": [
        "calc"
      ],
      "kde": "KCalc",
      "category": "Apps",
      "desktop": "org.kde.kcalc.desktop",
      "summary": "Simple, scientific and programmer modes, the same as you are used to."
    },
    {
      "id": "character-map",
      "windows": "Character Map",
      "aliases": [
        "charmap",
        "special characters",
        "accents",
        "symbol"
      ],
      "kde": "KCharSelect",
      "category": "Apps",
      "desktop": "org.kde.kcharselect.desktop",
      "summary": "Every character in the font, searchable by name."
    },
    {
      "id": "clipboard-history",
      "windows": "Clipboard history",
      "aliases": [
        "Win+V",
        "clipboard",
        "paste history"
      ],
      "kde": "Klipper",
      "category": "Shortcuts",
      "action": {
        "component": "plasmashell",
        "name": "show-on-mouse-pos"
      },
      "summary": "Everything you have copied, waiting in a list. It is on by default and lives in the system tray.",
      "icon": "klipper"
    },
    {
      "id": "terminal",
      "windows": "Command Prompt",
      "aliases": [
        "cmd",
        "PowerShell",
        "Windows Terminal",
        "console",
        "command line"
      ],
      "kde": "Konsole",
      "category": "System",
      "desktop": "org.kde.konsole.desktop",
      "summary": "Tabs, split panes and profiles. You will meet it in instructions more often than on Windows, and it is less of a last resort here."
    },
    {
      "id": "zip",
      "windows": "Compressed folder",
      "aliases": [
        "zip",
        "WinZip",
        "WinRAR",
        "7-zip",
        "extract",
        "unzip"
      ],
      "kde": "Ark",
      "category": "Files",
      "desktop": "org.kde.ark.desktop",
      "summary": "Zip, tar, 7z and rar, from Dolphin's right-click menu. Nothing to buy and no nag screen after thirty days."
    },
    {
      "id": "control-panel",
      "windows": "Control Panel",
      "aliases": [
        "control",
        "settings",
        "options",
        "preferences",
        "Win+I"
      ],
      "kde": "System Settings",
      "category": "Settings",
      "desktop": "systemsettings.desktop",
      "summary": "One window for the lot — appearance, hardware, users, networking — with a search box at the top that is usually faster than the categories."
    },
    {
      "id": "copilot",
      "windows": "Copilot",
      "aliases": [
        "Cortana",
        "assistant",
        "recall",
        "ai"
      ],
      "kde": "Not shipped",
      "category": "System",
      "icon": "dialog-information",
      "summary": "Nothing on this desktop watches what you do, records the screen, or sends it anywhere. If you want an assistant, you install one and it is yours."
    },
    {
      "id": "credentials",
      "windows": "Credential Manager",
      "aliases": [
        "saved passwords",
        "password vault",
        "keychain"
      ],
      "kde": "KWallet",
      "category": "System",
      "desktop": "org.kde.kwalletmanager.desktop",
      "summary": "Wi-Fi keys, saved logins and application passwords, unlocked with your login password."
    },
    {
      "id": "ctrl-alt-del",
      "windows": "Ctrl+Alt+Delete",
      "aliases": [
        "three finger salute",
        "sign out",
        "end task"
      ],
      "kde": "Log out screen",
      "category": "Shortcuts",
      "icon": "system-shutdown",
      "summary": "Offers to log out, restart or shut down. For a frozen window, Meta+Ctrl+Esc turns the pointer into a crosshair and kills the one you click."
    },
    {
      "id": "date-time",
      "windows": "Date and time",
      "aliases": [
        "timezone",
        "clock",
        "set time"
      ],
      "kde": "Date & Time",
      "category": "Settings",
      "desktop": "kcm_clock.desktop",
      "summary": "Time is set from the network by default. If you dual-boot Windows, this is where the two disagree about what the hardware clock means."
    },
    {
      "id": "default-apps",
      "windows": "Default apps",
      "aliases": [
        "default browser",
        "default program",
        "set defaults"
      ],
      "kde": "Default Applications",
      "category": "Settings",
      "desktop": "kcm_componentchooser.desktop",
      "summary": "Browser, email, terminal and file manager. Per-file-type choices are next door in File Associations."
    },
    {
      "id": "defrag",
      "windows": "Defragment",
      "aliases": [
        "defrag",
        "optimise drives",
        "disk optimisation"
      ],
      "kde": "Not needed",
      "category": "System",
      "icon": "drive-harddisk",
      "summary": "The file systems used here do not fragment the way NTFS did, and SSDs are trimmed automatically. There is nothing to schedule."
    },
    {
      "id": "device-manager",
      "windows": "Device Manager",
      "aliases": [
        "devmgmt.msc",
        "drivers",
        "hardware",
        "yellow triangle"
      ],
      "kde": "Info Centre",
      "category": "System",
      "desktop": "org.kde.kinfocenter.desktop",
      "summary": "Reports what hardware you have and what it is doing. There is usually nothing to install: drivers arrive with the system rather than from the manufacturer's website."
    },
    {
      "id": "disk-cleanup",
      "windows": "Disk Cleanup",
      "aliases": [
        "cleanmgr",
        "storage sense",
        "free up space",
        "what is using my disk"
      ],
      "kde": "Filelight",
      "category": "Apps",
      "desktop": "org.kde.filelight.desktop",
      "summary": "Shows what is actually filling the disk, as rings you can click into. There is no temp-file ritual to perform first."
    },
    {
      "id": "disk-management",
      "windows": "Disk Management",
      "aliases": [
        "diskmgmt.msc",
        "partitions",
        "format",
        "usb stick",
        "drive letters"
      ],
      "kde": "KDE Partition Manager",
      "category": "System",
      "desktop": "org.kde.partitionmanager.desktop",
      "summary": "Partition and format drives. There are no drive letters here: everything appears as a folder, and removable drives show up in Dolphin's Places when you plug them in."
    },
    {
      "id": "display-settings",
      "windows": "Display settings",
      "aliases": [
        "resolution",
        "scaling",
        "refresh rate",
        "multiple displays",
        "dpi"
      ],
      "kde": "Display Configuration",
      "category": "Settings",
      "desktop": "kcm_kscreen.desktop",
      "summary": "Resolution, refresh rate, scaling and how the screens are arranged. Fractional scaling works and does not need a sign-out."
    },
    {
      "id": "accessibility",
      "windows": "Ease of Access",
      "aliases": [
        "accessibility",
        "magnifier",
        "narrator",
        "high contrast",
        "sticky keys"
      ],
      "kde": "Accessibility",
      "category": "Settings",
      "desktop": "kcm_access.desktop",
      "summary": "Sticky keys, bell, mouse keys and screen reader settings. The screen magnifier is a KWin effect rather than a separate program."
    },
    {
      "id": "emoji",
      "windows": "Emoji panel",
      "aliases": [
        "Win+.",
        "emoji",
        "smiley",
        "symbols"
      ],
      "kde": "Emoji Selector",
      "category": "Shortcuts",
      "desktop": "org.kde.plasma.emojier.desktop",
      "summary": "The same chord, the same idea: pick one and it goes to the clipboard."
    },
    {
      "id": "event-viewer",
      "windows": "Event Viewer",
      "aliases": [
        "eventvwr",
        "logs",
        "system log",
        "errors"
      ],
      "kde": "KSystemLog",
      "category": "System",
      "desktop": "org.kde.ksystemlog.desktop",
      "summary": "The system's own account of what happened. When someone helping you asks for a log, this is where it is — or journalctl in Konsole, which is the same thing as text."
    },
    {
      "id": "favourites",
      "windows": "Favorites",
      "aliases": [
        "bookmarks",
        "favourites",
        "import bookmarks",
        "browser history"
      ],
      "kde": "Bookmarks — imported",
      "category": "Internet",
      "desktop": [
        "firefox.desktop",
        "firefox_firefox.desktop",
        "org.mozilla.firefox.desktop"
      ],
      "summary": "Bring them across on the first run: Firefox offers to import from Edge and Chrome, including history and saved logins. Signing into a browser account does it too, and keeps them in step with the machine you have not switched yet."
    },
    {
      "id": "file-explorer",
      "windows": "File Explorer",
      "aliases": [
        "explorer",
        "My Computer",
        "This PC",
        "my documents",
        "folders",
        "Win+E"
      ],
      "kde": "Dolphin",
      "category": "Files",
      "desktop": "org.kde.dolphin.desktop",
      "summary": "Your file manager. The left column is Places rather than This PC, and it does tabs, a split view and a built-in terminal."
    },
    {
      "id": "backup",
      "windows": "File History",
      "aliases": [
        "backup",
        "system restore",
        "restore point",
        "time machine"
      ],
      "kde": "Backups",
      "category": "Settings",
      "desktop": "kcm_kup.desktop",
      "summary": "Kup schedules backups to another disk or a remote. There is no restore point to roll back to instead — take backups."
    },
    {
      "id": "fonts",
      "windows": "Fonts",
      "aliases": [
        "install font",
        "font size",
        "cleartype",
        "ttf"
      ],
      "kde": "Fonts",
      "category": "Settings",
      "desktop": "kcm_fonts.desktop",
      "summary": "Sizes and anti-aliasing here; to install a font, open the file and press Install, or drop it in ~/.local/share/fonts."
    },
    {
      "id": "ftp",
      "windows": "FTP site",
      "aliases": [
        "ftp",
        "sftp",
        "webdav",
        "upload to server"
      ],
      "kde": "Dolphin's address bar",
      "category": "Internet",
      "desktop": "org.kde.dolphin.desktop",
      "summary": "Type sftp://user@host, ftp:// or webdavs:// into Dolphin and the remote machine becomes a folder — draggable, editable in place, and available to every application through the same address."
    },
    {
      "id": "games",
      "windows": "Games",
      "aliases": [
        "Xbox",
        "Steam",
        "Game Bar",
        "gaming",
        "directx"
      ],
      "kde": "Steam and Proton",
      "category": "Apps",
      "icon": "applications-games",
      "summary": "Install Steam from Discover and turn on Steam Play: most Windows games run through Proton, often unchanged. Anti-cheat is the usual exception — check ProtonDB before buying."
    },
    {
      "id": "search-indexing",
      "windows": "Indexing Options",
      "aliases": [
        "windows search",
        "search index",
        "find files"
      ],
      "kde": "File Search",
      "category": "Settings",
      "desktop": "kcm_baloofile.desktop",
      "summary": "What gets indexed for searching, and which folders to leave out. Searching is then done from KRunner or Dolphin."
    },
    {
      "id": "internet-options",
      "windows": "Internet Options",
      "aliases": [
        "inetcpl.cpl",
        "proxy",
        "proxy settings",
        "pac file"
      ],
      "kde": "Proxy",
      "category": "Internet",
      "desktop": "kcm_proxy.desktop",
      "summary": "System-wide proxy settings, including a PAC file. There is no equivalent of the rest of that dialogue: security zones and ActiveX were Internet Explorer's alone and went with it."
    },
    {
      "id": "ipconfig",
      "windows": "ipconfig",
      "aliases": [
        "ping",
        "netstat",
        "command line network",
        "cmd commands"
      ],
      "kde": "ip addr",
      "category": "System",
      "desktop": "org.kde.konsole.desktop",
      "summary": "ip addr for addresses, ping as before, ss for connections. The commands differ, and instructions you find will assume these ones."
    },
    {
      "id": "keyboard-settings",
      "windows": "Keyboard settings",
      "aliases": [
        "keyboard layout",
        "key repeat",
        "numlock"
      ],
      "kde": "Keyboard",
      "category": "Settings",
      "desktop": "kcm_keyboard.desktop",
      "summary": "Layouts, repeat rate, and whether NumLock is on at login — which is the setting everyone looks for on day one."
    },
    {
      "id": "keyboard-shortcuts",
      "windows": "Keyboard shortcuts",
      "aliases": [
        "hotkeys",
        "key bindings",
        "assign shortcut"
      ],
      "kde": "Shortcuts",
      "category": "Settings",
      "desktop": "kcm_keys.desktop",
      "summary": "Every shortcut on the system, rebindable, including the ones this application reads to answer you."
    },
    {
      "id": "lock",
      "windows": "Lock screen",
      "aliases": [
        "Win+L",
        "lock",
        "ctrl alt delete"
      ],
      "kde": "Lock Session",
      "category": "Shortcuts",
      "action": {
        "component": "ksmserver",
        "name": "Lock Session"
      },
      "summary": "Locks the session. Ctrl+Alt+Delete is not the way in here — it offers to log out or shut down instead.",
      "icon": "system-lock-screen"
    },
    {
      "id": "mail",
      "windows": "Mail",
      "aliases": [
        "Outlook",
        "email client",
        "Windows Mail"
      ],
      "kde": "Thunderbird",
      "category": "Internet",
      "desktop": [
        "thunderbird.desktop",
        "thunderbird_thunderbird.desktop",
        "org.mozilla.Thunderbird.desktop"
      ],
      "summary": "Thunderbird is the usual choice and imports from Outlook. KMail is the KDE one, and fits better if you use the rest of Kontact."
    },
    {
      "id": "map-network-drive",
      "windows": "Map network drive",
      "aliases": [
        "network share",
        "smb",
        "nas",
        "shared folder"
      ],
      "kde": "Dolphin — Network",
      "category": "Files",
      "desktop": "org.kde.dolphin.desktop",
      "summary": "Type smb://server/share into Dolphin's address bar, or use Network in Places. No drive letter is assigned; it is a folder like any other."
    },
    {
      "id": "microsoft-account",
      "windows": "Microsoft account",
      "aliases": [
        "sign in",
        "online account",
        "OneDrive account"
      ],
      "kde": "A local account",
      "category": "System",
      "icon": "user-identity",
      "summary": "Your account is on the machine. Nothing needs signing in to for the desktop to work, and you can add online accounts later if you want them."
    },
    {
      "id": "browser",
      "windows": "Microsoft Edge",
      "aliases": [
        "Internet Explorer",
        "browser",
        "Chrome",
        "internet"
      ],
      "kde": "Firefox",
      "category": "Internet",
      "desktop": [
        "firefox.desktop",
        "firefox_firefox.desktop",
        "org.mozilla.firefox.desktop"
      ],
      "summary": "Firefox comes with most systems; Chrome, Chromium, Vivaldi and Edge itself are all available. Your bookmarks and passwords come across by signing in or importing the profile."
    },
    {
      "id": "office",
      "windows": "Microsoft Office",
      "aliases": [
        "Word",
        "Excel",
        "PowerPoint",
        "docx",
        "xlsx"
      ],
      "kde": "LibreOffice",
      "category": "Apps",
      "desktop": "libreoffice-startcenter.desktop",
      "summary": "Opens and saves .docx, .xlsx and .pptx. For a document someone else must edit in Office, check the layout before you send it. Office on the web still works in the browser."
    },
    {
      "id": "store",
      "windows": "Microsoft Store",
      "aliases": [
        "add or remove programs",
        "install software",
        "appwiz.cpl",
        "uninstall",
        "Win+I",
        "download an installer",
        "exe",
        "setup.exe"
      ],
      "kde": "Discover",
      "category": "System",
      "desktop": "org.kde.discover.desktop",
      "summary": "Where software is installed and removed. Almost everything comes from here rather than from a downloaded installer, and it is free of charge and free of adverts."
    },
    {
      "id": "hotspot",
      "windows": "Mobile hotspot",
      "aliases": [
        "share connection",
        "wifi hotspot",
        "tethering"
      ],
      "kde": "Networks — Hotspot",
      "category": "Internet",
      "desktop": "kcm_networkmanagement.desktop",
      "summary": "Share a wired or mobile connection over Wi-Fi from the Networks page, if the adapter supports it. Tethering from a phone works the other way with no setup at all."
    },
    {
      "id": "mouse-settings",
      "windows": "Mouse settings",
      "aliases": [
        "pointer speed",
        "double-click",
        "left-handed"
      ],
      "kde": "Mouse",
      "category": "Settings",
      "desktop": "kcm_mouse.desktop",
      "summary": "Pointer speed, acceleration and button order."
    },
    {
      "id": "my-documents",
      "windows": "My Documents",
      "aliases": [
        "Documents",
        "Downloads",
        "Pictures",
        "user folder"
      ],
      "kde": "Your home folder",
      "category": "Files",
      "desktop": "org.kde.dolphin.desktop",
      "summary": "Documents, Downloads, Pictures and the rest live in your home folder, the same way, and Dolphin's Places lists them."
    },
    {
      "id": "streaming",
      "windows": "Netflix and Spotify",
      "aliases": [
        "netflix",
        "spotify",
        "streaming",
        "drm",
        "prime video",
        "youtube"
      ],
      "kde": "The browser, and Discover",
      "category": "Internet",
      "icon": "internet-web-browser",
      "summary": "Streaming sites work in Firefox and Chrome, with the DRM they need switched on the first time a site asks. Spotify has a Linux client in Discover, and so do most of the others."
    },
    {
      "id": "network-settings",
      "windows": "Network settings",
      "aliases": [
        "ncpa.cpl",
        "wifi",
        "wi-fi",
        "ethernet",
        "ip address",
        "vpn"
      ],
      "kde": "Networks",
      "category": "Settings",
      "desktop": "kcm_networkmanagement.desktop",
      "summary": "Wi-Fi, wired, VPN and mobile broadband. The tray icon is the quick way in; this is where saved connections are edited."
    },
    {
      "id": "night-light",
      "windows": "Night light",
      "aliases": [
        "blue light",
        "warm colours",
        "f.lux"
      ],
      "kde": "Night Light",
      "category": "Settings",
      "desktop": "kcm_nightlight.desktop",
      "summary": "Warms the screen after dark, on a schedule or by sunset at your location."
    },
    {
      "id": "notepad",
      "windows": "Notepad",
      "aliases": [
        "text editor",
        "txt",
        "notepad++",
        "wordpad"
      ],
      "kde": "Kate",
      "category": "Apps",
      "desktop": "org.kde.kate.desktop",
      "summary": "A text editor that grew up: syntax highlighting, a file tree, split views. KWrite is the same editor with the extras taken away."
    },
    {
      "id": "notifications",
      "windows": "Notifications",
      "aliases": [
        "action centre",
        "focus assist",
        "do not disturb",
        "toast"
      ],
      "kde": "Notifications",
      "category": "Settings",
      "desktop": "kcm_notifications.desktop",
      "summary": "Per-application rules, and a Do Not Disturb switch in the tray that actually stays where you put it."
    },
    {
      "id": "onedrive",
      "windows": "OneDrive",
      "aliases": [
        "cloud",
        "sync",
        "Google Drive",
        "Dropbox"
      ],
      "kde": "No client is shipped",
      "category": "Files",
      "summary": "Nothing syncs OneDrive out of the box. Dolphin can open a remote folder over the network, and rclone handles OneDrive and Google Drive properly, including keeping a folder in step.",
      "icon": "cloud-upload"
    },
    {
      "id": "file-associations",
      "windows": "Open with",
      "aliases": [
        "file associations",
        "file types",
        "default program",
        "change association"
      ],
      "kde": "File Associations",
      "category": "Settings",
      "desktop": "kcm_filetypes.desktop",
      "summary": "Which application opens which kind of file, searchable by extension. Dolphin's right-click Open With sets the same thing for one file."
    },
    {
      "id": "paint",
      "windows": "Paint",
      "aliases": [
        "mspaint",
        "paint 3d",
        "draw",
        "crop image"
      ],
      "kde": "KolourPaint",
      "category": "Apps",
